# ──────────────────────────────────────────────────────────────────────────────
# V7 Darwin ↔ Databricks integration — configuration
#
# Copy this file to `.env`, fill in the values, then run:
#   ./scripts/setup_databricks.sh
#
# `.env` is gitignored. NEVER commit real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── V7 Darwin ────────────────────────────────────────────────────────────────
# Team-scoped API key (Darwin → Settings → API keys, inside the target team).
# Needs dataset-management permissions.
DARWIN_API_KEY=

# Your Darwin environment. Leave as-is unless V7 gave you a dedicated URL.
DARWIN_BASE_URL=https://darwin.v7labs.com

# The team slug the API key belongs to (visible in Darwin URLs).
DARWIN_TEAM_SLUG=

# Dataset to register items into / export annotations from (created if missing).
DARWIN_DATASET_SLUG=databricks-sync

# Name of the external storage integration configured in Darwin
# (Settings → Storage → New Storage Integration, pointing at SOURCE_PATH's bucket).
DARWIN_STORAGE_NAME=

# ── Databricks ───────────────────────────────────────────────────────────────
# Either a CLI profile name (recommended; `databricks auth login`)...
DATABRICKS_PROFILE=
# ...or host + token (used only when DATABRICKS_PROFILE is empty).
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# SQL warehouse used to create the target schema (ID from SQL Warehouses page).
DATABRICKS_WAREHOUSE_ID=

# Where to import the notebooks in the workspace.
WORKSPACE_DIR=/Shared/v7-darwin

# Secret scope + key that will hold DARWIN_API_KEY inside Databricks.
SECRET_SCOPE=v7-darwin
SECRET_KEY=darwin-api-key

# ── Data locations ───────────────────────────────────────────────────────────
# Where your files live: an s3:// path readable via a Unity Catalog external
# location. The same bucket must be connected to Darwin as external storage.
SOURCE_PATH=s3://YOUR-BUCKET/YOUR-PREFIX/

# Target Delta table for annotations (catalog.schema.table). Schema is created
# by the setup script; the table is created on the first export run.
TARGET_TABLE=main.v7_darwin.annotations

# ── Sync job (optional) ──────────────────────────────────────────────────────
# Quartz cron for the recurring export job, e.g. every 15 min: "0 0/15 * * * ?"
# Leave empty to skip creating the schedule (run the notebook manually instead).
SYNC_SCHEDULE_CRON=
SYNC_SCHEDULE_TZ=UTC
